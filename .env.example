# Copy to .env.local and fill in. Only PUBLIC values belong here — never the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public VAPID key (the private key is a Supabase Edge Function secret only)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# GitHub Pages sub-path, e.g. /mealtrack/ (use / for a custom domain or local dev)
VITE_BASE_PATH=/
